#!/usr/bin/env python3
"""Plugin manager helper for DankShell's Plugins window (replaces Omaplug).
Everything goes through Omarchy's own `omarchy plugin` commands.

  plugin-manage catalog          marketplace plugins you can install (JSON list),
                                 cached an hour in ~/.cache/dankshell/catalog.json
  plugin-manage check            which installed git plugins have an update (JSON map)
  plugin-manage gitcheck         git installs (God's Eye View, ComfyUI, the clones in
                                 ~/GitDank/CloneWars) and how far behind their repo they are
  plugin-manage run ACTION ARG   install <github-url> | update <id> | remove <id>,
                                 meant to be started detached: it writes its progress
                                 to ~/.cache/dankshell/plugin-job.json, so the job
                                 survives the shell reloading plugins under it.
  plugin-manage batch ITEM...    update several at once, one after another; an item is
                                 plugin:<id> or git:<path from gitcheck>. Same job file.

Git installs: every git checkout in ~/GitDank/CloneWars plus ~/ComfyUI. Your own
repos (Dankestrick on GitHub/GitLab) and plugin clones (a manifest.json) are left out. ~/.config/dankshell/git-installs.json
can add more: {"add": ["/path/to/checkout"], "skip": ["folder-name"]}.
"""
import json, os, re, subprocess, sys, time, urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HOME = Path.home()
PLUGINS = HOME / ".config/omarchy/plugins"
CACHE = HOME / ".cache/dankshell"
CATALOG_URL = "https://plugins.omarchy.org/catalog.json"
JOB = CACHE / "plugin-job.json"
ENV = dict(os.environ, OMARCHY_SHELL_IPC_TIMEOUT="20s", GIT_TERMINAL_PROMPT="0",
           GIT_SSH_COMMAND=os.environ.get("GIT_SSH_COMMAND", "ssh -oBatchMode=yes"))
ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
GH_RE = re.compile(r"^https://github\.com/[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*?(\.git)?/?$")
# Never removed from here: the shell itself.
PROTECTED = {"io.github.dankestrick.dankshell"}


def valid_id(s):
    return bool(ID_RE.match(s or "")) and ".." not in s


def github_url(entry):
    for key in ("repo", "repositoryUrl", "sourceUrl", "source"):
        u = entry.get(key)
        if isinstance(u, str) and GH_RE.match(u.rstrip("/")) and ".." not in u:
            return u.rstrip("/")
    m = re.search(r"https://github\.com/[^\s`]+", str(entry.get("installCommand", "")))
    if m and GH_RE.match(m.group(0)) and ".." not in m.group(0):
        return m.group(0)
    return ""


def catalog():
    CACHE.mkdir(parents=True, exist_ok=True)
    cached = CACHE / "catalog.json"
    raw = None
    if cached.is_file() and time.time() - cached.stat().st_mtime < 3600:
        try:
            raw = json.loads(cached.read_text())
        except ValueError:
            raw = None
    if raw is None:
        req = urllib.request.Request(CATALOG_URL, headers={"User-Agent": "dankshell"})
        with urllib.request.urlopen(req, timeout=30) as r:
            raw = json.loads(r.read(96 * 1024 * 1024))
        cached.write_text(json.dumps(raw))
    out = []
    for e in raw.get("plugins", []) if isinstance(raw, dict) else []:
        if not isinstance(e, dict) or not valid_id(e.get("id")) or e.get("builtIn"):
            continue
        url = github_url(e)
        if not url or e.get("installAvailable") is False:
            continue
        out.append({
            "id": e["id"], "name": str(e.get("name") or e["id"])[:80],
            "author": str(e.get("author") or "")[:80],
            "description": str(e.get("description") or "")[:300],
            "version": str(e.get("version") or "")[:32],
            "category": str(e.get("category") or "")[:40],
            "kind": str(e.get("kind") or "")[:40],
            "verified": e.get("verificationStatus") == "verified",
            "stars": int(e.get("stars") or 0) if str(e.get("stars") or "0").isdigit() else 0,
            "url": url,
        })
    out.sort(key=lambda p: (not p["verified"], -p["stars"], p["name"].lower()))
    print(json.dumps(out))


def git(d, *args, timeout=25):
    return subprocess.run(["git", "-C", str(d), *args], capture_output=True, text=True, timeout=timeout, env=ENV)


def plugin_id(d):
    try:
        return json.loads((d / "manifest.json").read_text()).get("id") or d.name
    except (OSError, ValueError):
        return d.name


def check_one(d):
    r = check_dir(d)
    return plugin_id(d), r


def check_dir(d):
    try:
        if d.is_symlink() or not (d / ".git").is_dir():
            return {"git": False}
        if git(d, "status", "--porcelain").stdout.strip():
            return {"git": True, "update": False, "note": "has local changes"}
        if git(d, "fetch", "--quiet", "origin", "HEAD").returncode != 0:
            return {"git": True, "update": False, "note": "couldn't reach its repo"}
        head = git(d, "rev-parse", "HEAD").stdout.strip()
        remote = git(d, "rev-parse", "FETCH_HEAD").stdout.strip()
        behind = git(d, "merge-base", "--is-ancestor", "HEAD", "FETCH_HEAD").returncode == 0 and head != remote
        return {"git": True, "update": behind, "head": head[:7], "remote": remote[:7]}
    except (OSError, subprocess.SubprocessError) as e:
        return {"git": False, "note": str(e)[:120]}


def check():
    dirs = [d for d in PLUGINS.iterdir() if d.is_dir() and not d.name.startswith(".")] if PLUGINS.is_dir() else []
    # the folder name is the plugin id for git installs
    with ThreadPoolExecutor(8) as pool:
        print(json.dumps(dict(pool.map(check_one, dirs))))


GIT_ROOTS = [HOME / "GitDank/CloneWars"]
GIT_SINGLES = [HOME / "ComfyUI"]
GIT_CONFIG = HOME / ".config/dankshell/git-installs.json"
OWN = re.compile(r"(github|gitlab)\.com[/:]dankestrick/", re.I)


def git_dirs():
    try:
        cfg = json.loads(GIT_CONFIG.read_text())
    except (OSError, ValueError):
        cfg = {}
    skip = set(cfg.get("skip") or [])
    found = []
    for root in GIT_ROOTS:
        if root.is_dir():
            found += sorted(d for d in root.iterdir() if d.is_dir() and not d.is_symlink())
    found += GIT_SINGLES + [Path(x).expanduser() for x in cfg.get("add") or [] if isinstance(x, str)]
    out = []
    for d in found:
        if d.name in skip or not (d / ".git").is_dir() or d in out:
            continue
        # A plugin clone: installed plugins update in the Plugins list, and a
        # clone of one you removed (omaplug, omacale) is only a kept copy.
        if (d / "manifest.json").is_file():
            continue
        url = git(d, "remote", "get-url", "origin").stdout.strip()
        if url and not OWN.search(url):
            out.append(d)
    return out


def upstream(d):
    u = git(d, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if u.returncode == 0 and u.stdout.strip():
        return u.stdout.strip()
    b = git(d, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    if git(d, "rev-parse", "--verify", "--quiet", "origin/" + b).returncode == 0:
        return "origin/" + b
    return "origin/HEAD"


def gitcheck_one(d):
    row = {"path": str(d), "name": d.name, "behind": 0, "update": False, "note": ""}
    try:
        row["branch"] = git(d, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
        if git(d, "fetch", "--quiet", "--no-tags", "origin", timeout=60).returncode != 0:
            row["note"] = "couldn't reach its repo"; return row
        u = upstream(d)
        counts = git(d, "rev-list", "--left-right", "--count", "HEAD..." + u).stdout.split()
        ahead, behind = (int(counts[0]), int(counts[1])) if len(counts) == 2 else (0, 0)
        row["behind"] = behind
        if behind and ahead:
            row["note"] = "has its own commits, update it by hand"
        elif behind:
            row["update"] = True
            row["last"] = git(d, "log", "-1", "--format=%cr", u).stdout.strip()
            if git(d, "status", "--porcelain", "--untracked-files=no").stdout.strip():
                row["note"] = "has local changes (they're kept)"
    except (OSError, subprocess.SubprocessError) as e:
        row["note"] = str(e)[:120]
    return row


def gitcheck():
    with ThreadPoolExecutor(8) as pool:
        print(json.dumps(list(pool.map(gitcheck_one, git_dirs()))))


def git_update(d):
    """Fast-forward one checkout. Returns (ok, message)."""
    old = git(d, "rev-parse", "HEAD").stdout.strip()
    p = git(d, "pull", "--ff-only", "--quiet", "--no-rebase", timeout=300)
    if p.returncode != 0:
        lines = [l for l in (p.stderr + p.stdout).splitlines() if l.strip() and not l.startswith(("hint:", "remote:"))]
        return False, (lines[-1] if lines else "git pull failed")[:300]
    new = git(d, "rev-parse", "HEAD").stdout.strip()
    n = git(d, "rev-list", "--count", old + ".." + new).stdout.strip() or "0"
    changed = set(git(d, "diff", "--name-only", old, new).stdout.split())
    msg = n + (" new commit" if n == "1" else " new commits")
    # Node apps (God's Eye View): reinstall packages when the lock file changed.
    if "package-lock.json" in changed and (d / "node_modules").is_dir():
        env = dict(ENV, PUPPETEER_SKIP_DOWNLOAD="1")
        r = subprocess.run(["mise", "exec", "--", "npm", "ci"], cwd=d, capture_output=True, text=True,
                           timeout=900, env=env, stdin=subprocess.DEVNULL)
        msg += ", packages reinstalled" if r.returncode == 0 else ", but npm ci failed (run it by hand)"
    if any(f.endswith("requirements.txt") for f in changed):
        msg += ", its Python requirements changed"
    return True, msg


def batch(items):
    allowed = {str(d) for d in git_dirs()}
    jobs = []
    for it in items:
        kind, _, target = it.partition(":")
        if kind == "plugin" and valid_id(target):
            jobs.append({"kind": "plugin", "target": target, "name": target, "state": "waiting", "message": ""})
        elif kind == "git" and target in allowed:
            jobs.append({"kind": "git", "target": target, "name": Path(target).name, "state": "waiting", "message": ""})
    if not jobs:
        write_job(state="failed", action="batch", items=[], message="Nothing to update", at=time.time()); return 1
    write_job(state="running", action="batch", items=jobs, at=time.time())
    for j in jobs:
        j["state"] = "running"
        write_job(state="running", action="batch", items=jobs, at=time.time())
        try:
            if j["kind"] == "plugin":
                p = subprocess.run(["omarchy", "plugin", "update", j["target"], "--yes"], capture_output=True, text=True,
                                   timeout=300, env=ENV, stdin=subprocess.DEVNULL)
                out = [l for l in p.stdout.splitlines() if l.strip()]
                err = [l for l in p.stderr.splitlines() if l.strip() and not l.startswith(("remote:", "Receiving", "Resolving"))]
                pick = (err or out) if p.returncode else (out or err)
                ok, msg = p.returncode == 0, (pick[-1][:300] if pick else "")
            else:
                ok, msg = git_update(Path(j["target"]))
        except (OSError, subprocess.SubprocessError) as e:
            ok, msg = False, str(e)[:300]
        j["state"], j["message"] = ("done" if ok else "failed"), msg
    bad = sum(j["state"] == "failed" for j in jobs)
    write_job(state="failed" if bad == len(jobs) else "done", action="batch", items=jobs, at=time.time())
    return 1 if bad else 0


def write_job(**k):
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = JOB.with_suffix(".tmp")
    tmp.write_text(json.dumps(k))
    tmp.replace(JOB)


def run(action, arg):
    if action == "install":
        if not GH_RE.match(arg.rstrip("/")) or ".." in arg:
            write_job(state="failed", action=action, target=arg, message="Not a GitHub link", at=time.time()); return 1
        cmd = ["omarchy", "plugin", "add", arg, "--enable", "--yes"]
    elif action in ("update", "remove"):
        if not valid_id(arg) or (action == "remove" and arg in PROTECTED):
            write_job(state="failed", action=action, target=arg, message="Can't do that to this plugin", at=time.time()); return 1
        cmd = ["omarchy", "plugin", action, arg, "--yes"]
    else:
        return 2
    write_job(state="running", action=action, target=arg, message="", at=time.time())
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=300, env=ENV, stdin=subprocess.DEVNULL)
        # Omarchy's own last line (stdout) says what happened; git chatter goes to stderr.
        out = [l for l in p.stdout.splitlines() if l.strip()]
        err = [l for l in p.stderr.splitlines() if l.strip() and not l.startswith(("Cloning into", "remote:", "Receiving", "Resolving"))]
        pick = (err or out) if p.returncode != 0 else (out or err)
        msg = pick[-1][:300] if pick else ""
        write_job(state="done" if p.returncode == 0 else "failed", action=action, target=arg, message=msg, at=time.time())
        return p.returncode
    except (OSError, subprocess.SubprocessError) as e:
        write_job(state="failed", action=action, target=arg, message=str(e)[:300], at=time.time())
        return 1


if __name__ == "__main__":
    a = sys.argv[1:]
    if a[:1] == ["catalog"]:
        catalog()
    elif a[:1] == ["check"]:
        check()
    elif a[:1] == ["gitcheck"]:
        gitcheck()
    elif len(a) >= 2 and a[0] == "batch":
        sys.exit(batch(a[1:]))
    elif len(a) == 3 and a[0] == "run":
        sys.exit(run(a[1], a[2]))
    else:
        print(__doc__, file=sys.stderr)
        sys.exit(2)
