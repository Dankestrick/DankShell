#!/usr/bin/env bash
# camera — small helper for the Camera page (services/Camera.qml).
#   camera find               -> the webcam's /dev/videoN (found by name)
#   camera name               -> the webcam's name
#   camera ctrls DEV          -> v4l2-ctl --list-ctrls for DEV
#   camera set DEV k=v ...    -> set each control in order, one at a time,
#                                so one refused value doesn't stop the rest
# Set $DANKSHELL_CAMERA to pick a camera by name. Without it, the first real
# USB/built-in camera is used (virtual v4l2loopback cameras are skipped).
set -u
NAME="${DANKSHELL_CAMERA:-}"

# Prints "name<TAB>/dev/videoN" for the camera in use.
pick() {
  v4l2-ctl --list-devices 2>/dev/null | awk -v n="$NAME" '
    /^[^ \t]/ {
      head = $0; sub(/ \(.*$/, "", head); sub(/:.*$/, "", head)
      f = (n != "") ? (index($0, n) == 1) : ($0 !~ /v4l2loopback|platform:/)
      next
    }
    f && /\/dev\/video/ { d = $0; gsub(/[ \t]/, "", d); print head "\t" d; exit }'
}

case "${1:-}" in
  find)
    pick | cut -f2
    ;;
  name)
    pick | cut -f1
    ;;
  ctrls)
    [ -n "${2:-}" ] && v4l2-ctl -d "$2" --list-ctrls 2>/dev/null
    ;;
  set)
    dev="${2:-}"; shift 2 || exit 1
    rc=0
    for kv in "$@"; do
      v4l2-ctl -d "$dev" --set-ctrl "$kv" >/dev/null 2>&1 || { echo "refused $kv" >&2; rc=1; }
    done
    exit $rc
    ;;
  *)
    echo "usage: camera find | name | ctrls DEV | set DEV name=value..." >&2
    exit 2
    ;;
esac
