# Every type in DankShell is listed here, so any file can use any other
# by importing the root folder ("../.." from modules/island, ".." from config).

# config/ — the knobs you tweak
singleton Sizes 1.0 config/Sizes.qml
singleton Motion 1.0 config/Motion.qml
singleton Theme 1.0 config/Theme.qml

# services/ — where data comes from
singleton Time 1.0 services/Time.qml
singleton Media 1.0 services/Media.qml
singleton Audio 1.0 services/Audio.qml
singleton Toggles 1.0 services/Toggles.qml
singleton PluginHost 1.0 services/PluginHost.qml

# components/ — small reusable pieces
